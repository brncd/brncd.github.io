---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

const posts = (await getCollection('blog')).sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---
<Layout title="Blog - Todas las entradas" description="Archivo de todas las entradas del blog sobre desarrollo, tecnología y más.">
  <div 
    id="page-wrapper" 
    class="bg-transparent min-h-screen transition-colors duration-500 relative py-8">
    <div id="main-content" class="max-w-5xl mx-auto bg-[var(--page-paper)] border-[var(--page-border)] border">
      <Header />
      <main class="py-20 px-12 md:px-16 lg:px-20">
        <div class="max-w-4xl mx-auto">
          <h1 class="font-display text-4xl font-bold mb-6 text-[var(--page-text)] text-center flex items-center justify-center gap-4">
            <svg id="pen-nib-solid" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-9 w-9 text-[var(--page-accent)]" fill="currentColor">
              <polygon points="23 4 23 7 22 7 22 8 21 8 21 9 20 9 20 10 19 10 19 9 18 9 18 8 17 8 17 7 16 7 16 6 15 6 15 5 14 5 14 4 15 4 15 3 16 3 16 2 17 2 17 1 20 1 20 2 21 2 21 3 22 3 22 4 23 4"/>
              <polygon points="18 11 19 11 19 12 18 12 18 15 17 15 17 18 16 18 16 19 14 19 14 20 11 20 11 21 8 21 8 22 5 22 5 23 3 23 3 22 4 22 4 21 5 21 5 20 6 20 6 19 7 19 7 18 8 18 8 17 9 17 9 16 12 16 12 13 11 13 11 12 8 12 8 15 7 15 7 16 6 16 6 17 5 17 5 18 4 18 4 19 3 19 3 20 2 20 2 21 1 21 1 19 2 19 2 16 3 16 3 13 4 13 4 10 5 10 5 8 6 8 6 7 9 7 9 6 12 6 12 5 13 5 13 6 14 6 14 7 15 7 15 8 16 8 16 9 17 9 17 10 18 10 18 11"/>
            </svg>
            <span>Archivo del Blog</span>
          </h1>
          <p class="text-xl text-[var(--page-text-secondary)] mb-16 text-center max-w-2xl mx-auto font-serif">
            // Todas las reflexiones sobre desarrollo, tecnología y mejores prácticas.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {posts.map((post) => (
              <BlogPostCard post={post} />
            ))}
          </div>
          <div class="text-center mt-16">
            <a href="/" class="inline-flex items-center text-[var(--page-text)] font-mono px-6 py-2 border border-[var(--page-border)] hover:bg-[var(--page-text)] hover:text-[var(--page-bg)] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="mr-2 h-4 w-4" fill="currentColor"><path d="M10 16l1.41-1.41L7.83 11H22V9H7.83l3.58-3.59L10 4l-6 6 6 6z"/></svg>
                Volver al inicio
            </a>
          </div>
        </div>
      </main>
      <Footer />
    </div>
  </div>
</Layout>