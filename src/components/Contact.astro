---
import { SITE_CONFIG } from '../site.config';
---
<section id="contact" class="py-20 px-12 md:px-16 lg:px-20">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="font-display text-4xl font-bold mb-8 text-[var(--page-text)] flex items-center justify-center gap-4">
      <svg id="phone-ringing-high-solid" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-9 w-9 text-[var(--page-accent)]" fill="currentColor">
        <polygon points="12 7 12 5 15 5 15 6 16 6 16 7 17 7 17 8 18 8 18 9 19 9 19 12 17 12 17 10 16 10 16 9 15 9 15 8 14 8 14 7 12 7"/>
        <rect x="12" y="10" width="2" height="2"/>
        <polygon points="23 8 23 12 21 12 21 8 20 8 20 7 19 7 19 6 18 6 18 5 17 5 17 4 16 4 16 3 12 3 12 1 16 1 16 2 18 2 18 3 19 3 19 4 20 4 20 5 21 5 21 6 22 6 22 8 23 8"/>
        <polygon points="22 17 23 17 23 20 22 20 22 22 21 22 21 23 16 23 16 22 12 22 12 21 10 21 10 20 9 20 9 19 8 19 8 18 7 18 7 17 6 17 6 16 5 16 5 15 4 15 4 14 3 14 3 12 2 12 2 8 1 8 1 3 2 3 2 2 4 2 4 1 7 1 7 2 8 2 8 3 9 3 9 5 10 5 10 8 9 8 9 9 8 9 8 12 9 12 9 13 10 13 10 14 11 14 11 15 12 15 12 16 15 16 15 15 16 15 16 14 19 14 19 15 21 15 21 16 22 16 22 17"/>
      </svg>
      <span>Contacto</span>
    </h2>
    <p class="text-xl text-[var(--page-text-secondary)] mb-12 leading-relaxed transition-colors duration-300 max-w-2xl mx-auto font-serif">
      {SITE_CONFIG.closing}
    </p>
    <a href={SITE_CONFIG.socials.email} class="inline-flex items-center justify-center px-8 py-3 bg-[var(--page-button)] text-[var(--page-bg)] border-0 rounded-none font-mono hover:bg-[var(--page-text)] hover:text-[var(--page-bg)]">
      <svg id="envelope-solid" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="mr-2 h-5 w-5" fill="currentColor"><polygon points="21 4 21 5 20 5 20 6 19 6 19 7 18 7 18 8 17 8 17 9 16 9 16 10 15 10 15 11 14 11 14 12 13 12 13 13 11 13 11 12 10 12 10 11 9 11 9 10 8 10 8 9 7 9 7 8 6 8 6 7 5 7 5 6 4 6 4 5 3 5 3 4 21 4"/><polygon points="23 5 23 19 22 19 22 20 2 20 2 19 1 19 1 5 3 5 3 6 4 6 4 7 5 7 5 8 6 8 6 9 7 9 7 10 8 10 8 11 9 11 9 12 10 12 10 13 11 13 11 14 13 14 13 13 14 13 14 12 15 12 15 11 16 11 16 10 17 10 17 9 18 9 18 8 19 8 19 7 20 7 20 6 21 6 21 5 23 5"/></svg>
      :mail
    </a>
  </div>
</section>

<style>
  /* No @apply directives here. Only custom CSS if needed. */
</style>