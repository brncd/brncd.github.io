---
import { Image } from 'astro:assets';
import SocialLink from './SocialLink.astro';
import { SITE_CONFIG } from '../site.config';
import profileImage from '../assets/images/profile.png';
---
<section id="about" class="py-16 px-12 md:px-16 lg:px-20">
  <div class="max-w-4xl mx-auto">
    <!-- Identity Block -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-8 mb-8">
      <!-- Image -->
      <div class="flex-shrink-0">
        <div class="w-28 h-28 border border-[var(--page-border)] bg-[var(--page-paper)] p-1.5 group">
          <Image 
            src={profileImage} 
            alt={`Foto de ${SITE_CONFIG.name}`} 
            width={112}
            height={112}
            loading="eager"
            class="w-full h-full object-cover border border-[var(--page-border)] bg-[var(--page-accent)] group-hover:bg-[var(--page-text)]" 
          />
        </div>
      </div>
      <!-- Titles -->
      <div class="text-center">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-[var(--page-text)] mb-2 leading-tight">
          {SITE_CONFIG.name}
        </h1>
        <h2 class="font-display text-xl md:text-2xl font-bold text-[var(--page-accent)] leading-tight">
          {SITE_CONFIG.subtitle}
        </h2>
      </div>
    </div>

    <!-- Bio and Socials -->
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xl leading-relaxed text-[var(--page-text-secondary)] font-serif mb-8">
        {SITE_CONFIG.bio}
      </p>
      <div class="flex gap-6 justify-center mt-8">
        <SocialLink href={SITE_CONFIG.socials.github} ariaLabel="GitHub">
          <svg id="github" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><polygon points="23 9 23 15 22 15 22 17 21 17 21 19 20 19 20 20 19 20 19 21 18 21 18 22 16 22 16 23 15 23 15 18 14 18 14 17 15 17 15 16 17 16 17 15 18 15 18 14 19 14 19 9 18 9 18 6 16 6 16 7 15 7 15 8 14 8 14 7 10 7 10 8 9 8 9 7 8 7 8 6 6 6 6 9 5 9 5 14 6 14 6 15 7 15 7 16 9 16 9 18 7 18 7 17 6 17 6 16 4 16 4 17 5 17 5 19 6 19 6 20 9 20 9 23 8 23 8 22 6 22 6 21 5 21 5 20 4 20 4 19 3 19 3 17 2 17 2 15 1 15 1 9 2 9 2 7 3 7 3 5 4 5 4 4 5 4 5 3 7 3 7 2 9 2 9 1 15 1 15 2 17 2 17 3 19 3 19 4 20 4 20 5 21 5 21 7 22 7 22 9 23 9"/></svg>
        </SocialLink>
        <SocialLink href={SITE_CONFIG.socials.linkedin} ariaLabel="LinkedIn">
          <svg id="linkedin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><path d="m22,2v-1H2v1h-1v20h1v1h20v-1h1V2h-1Zm-9,10v8h-3v-11h3v1h1v-1h4v1h1v10h-3v-8h-3Zm-9-4v-3h3v3h-3Zm3,1v11h-3v-11h3Z"/></svg>
        </SocialLink>
        <SocialLink href={SITE_CONFIG.socials.email} ariaLabel="Email">
          <svg id="envelope-solid" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><polygon points="21 4 21 5 20 5 20 6 19 6 19 7 18 7 18 8 17 8 17 9 16 9 16 10 15 10 15 11 14 11 14 12 13 12 13 13 11 13 11 12 10 12 10 11 9 11 9 10 8 10 8 9 7 9 7 8 6 8 6 7 5 7 5 6 4 6 4 5 3 5 3 4 21 4"/><polygon points="23 5 23 19 22 19 22 20 2 20 2 19 1 19 1 5 3 5 3 6 4 6 4 7 5 7 5 8 6 8 6 9 7 9 7 10 8 10 8 11 9 11 9 12 10 12 10 13 11 13 11 14 13 14 13 13 14 13 14 12 15 12 15 11 16 11 16 10 17 10 17 9 18 9 18 8 19 8 19 7 20 7 20 6 21 6 21 5 23 5"/></svg>
        </SocialLink>
      </div>
    </div>
  </div>
</section>